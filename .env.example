# ================================
# Cápi Frontend — Environment Config
# ================================

# Backend API URL (https en producción)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL pública del sitio: se usa en canonical, sitemap, robots y OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Client ID (Web) — mismo valor que el backend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Google Analytics 4 (opcional). Medición async con env var.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (opcional). Si se define, el backend debe tener el secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Verificación de Search Console: token sin el prefijo "google" ni la extensión .txt
GSC_VERIFICATION_TOKEN=
